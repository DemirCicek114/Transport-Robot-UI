# IntelliTrolley central-compute settings.
# Copy this file to ~/.config/intellitrolley/central.env and review it.

# Leave this unset for packaged installs; the supervisor infers the workspace
# from its own release directory. Set it only for a development checkout.
# INTELLITROLLEY_WORKSPACE=$HOME/dev_ws
INTELLITROLLEY_DATA_DIR=$HOME/.local/share/intellitrolley
INTELLITROLLEY_STATE_DIR=$HOME/.local/state/intellitrolley
INTELLITROLLEY_MAP_NAME=atrium_navigation
INTELLITROLLEY_BIND_HOST=0.0.0.0
INTELLITROLLEY_PORT=8000
INTELLITROLLEY_LAUNCH_RVIZ=false

# The Pi and central computer must use the same domain.
ROS_DOMAIN_ID=0
ROS_LOCALHOST_ONLY=0
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# Defaults to the installed my_bot Cyclone DDS file when omitted.
# CYCLONEDDS_URI=file:///home/<user>/dev_ws/install/my_bot/share/my_bot/config/cyclonedds.xml
